# Copy this file to .env for local development
# cp .env.example .env

# NextAuth secret (any random string)
AUTH_SECRET=change-me

# Encryption key used in src/lib/encryption.ts
# Recommended: 32-byte hex string
ENCRYPTION_KEY=change-me

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=change-me
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me

# API Key for Desktop Application
API_SECRET_KEY=change-me

# AI Provider Keys (รองรับ fallback ระหว่าง providers)
GEMINI_API_KEY=change-me
ANTHROPIC_API_KEY=change-me
OPENROUTER_API_KEY=change-me
OPENAI_API_KEY=change-me

# AI quota guard (ตัวเลือก)
# AI_MAX_REQUESTS_PER_MINUTE=30
# AI_MAX_REQUESTS_PER_HOUR=600

# ซ่อนบัญชีนี้ออกจากรายการผู้ใช้ใน /admin/users (บัญชียังใช้ล็อกอินได้ตามปกติ, ตัวเลือก)
# SUPER_ADMIN_EMAIL=dev@example.com

# Public base URL, used for Stripe Checkout success/cancel redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — agency-wide subscription that gates AI features (see src/lib/billing.ts)
STRIPE_SECRET_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me
STRIPE_PRICE_ID=change-me
